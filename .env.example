# Copy this file to `.env` for local development (gitignored - never
# commit the real one). On Render, set these directly in the service's
# Environment tab instead of uploading a .env file.

# --- Supabase Postgres ---
# Supabase dashboard -> Project Settings -> Database -> Connection string
# (use the "Transaction" pooler URI, port 6543, for a serverless-friendly
# pool; the direct 5432 URI also works for a single long-running service
# like Render).
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@YOUR-PROJECT.supabase.co:6543/postgres

# --- Stripe ---
# Dashboard -> Developers -> API keys. Use the sk_test_... key while
# testing, swap to sk_live_... only once you're ready to take real money.
STRIPE_SECRET_KEY=sk_test_...
# Dashboard -> Developers -> Webhooks -> (your endpoint) -> Signing secret.
# Only exists once you've created the webhook endpoint pointing at
# https://your-api-domain/api/billing/webhook
STRIPE_WEBHOOK_SECRET=whsec_...
# Dashboard -> Product catalog -> create a one-time Price for each:
#   "Single export"  - ~5.00 PLN, one-time (NOT recurring)
#   "30-day pass"     - ~30.00 PLN, one-time (NOT recurring)
# Paste each Price's ID (starts with price_...), not the Product ID.
STRIPE_PRICE_EXPORT=price_...
STRIPE_PRICE_PASS=price_...

# --- Anonymous device cookie signing ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Changing this invalidates every existing device cookie (everyone's free-
# export counter effectively resets) - treat it like a real secret.
COOKIE_SIGNING_SECRET=change-me-to-a-random-64-char-hex-string

# Only needed once frontend + backend live on subdomains of the same
# domain (e.g. app.yourdomain.pl + api.yourdomain.pl) - set to
# ".yourdomain.pl" (leading dot) so the device cookie is shared between
# them. Leave unset for local dev or same-origin deploys.
COOKIE_DOMAIN=

# --- CORS + redirect URLs ---
# Comma-separated, exact origins (scheme+host+port) allowed to call the
# API with cookies. No wildcards once cookies are involved.
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Where the frontend lives - used to build Stripe Checkout's success/
# cancel redirect URLs. Update the moment a real domain exists.
SITE_URL=http://localhost:8080

# --- Pricing (optional overrides - sensible defaults baked into settings.py) ---
# FREE_EXPORT_LIMIT=2
# EXPORT_PRICE_GROSZE=500
# PASS_PRICE_GROSZE=3000
# PASS_DURATION_DAYS=30
