      long stopsLevelPoints0  = SymbolInfoInteger(TradeSymbol_0, SYMBOL_TRADE_STOPS_LEVEL);
      long freezeLevelPoints0 = SymbolInfoInteger(TradeSymbol_0, SYMBOL_TRADE_FREEZE_LEVEL);
