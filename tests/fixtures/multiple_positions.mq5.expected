//+------------------------------------------------------------------+
//| Expert tick function                                              |
//+------------------------------------------------------------------+
void OnTick()
  {
   //--- Virtual Stop Loss / Take Profit monitor: runs on EVERY tick (not
   //--- gated to new bars), since price can cross a stop level at any
   //--- moment, not just on a bar close. This never sends SL/TP to the
   //--- broker's server at all - it watches the live price itself and
   //--- closes each tracked position directly, which works regardless of
   //--- whether this broker/account accepts server-side attached stops.
   //--- Shared across every rule below - iterates every tracked position
   //--- independently (a THEN block can contain more than one, and there
   //--- can be more than one rule), walking backwards since
   //--- RemoveVirtualStop() swap-removes from the array. g_vsSymbol[i]
   //--- (not a single global symbol) is used for the price check, since
   //--- different rules can track positions on different symbols.
   for(int i = ArraySize(g_vsPositionId) - 1; i >= 0; i--)
     {
      if(!PositionSelectByTicket(g_vsPositionId[i]))
        {
         // Position no longer exists (closed some other way) - stop tracking it.
         RemoveVirtualStop(i);
         continue;
        }

      double checkPrice = (g_vsDirection[i] == 1)
         ? SymbolInfoDouble(g_vsSymbol[i], SYMBOL_BID)   // BUY exits by selling, at Bid
         : SymbolInfoDouble(g_vsSymbol[i], SYMBOL_ASK);  // SELL exits by buying, at Ask

      bool hitSL = (g_vsSL[i] > 0) &&
         ((g_vsDirection[i] == 1) ? (checkPrice <= g_vsSL[i]) : (checkPrice >= g_vsSL[i]));
      bool hitTP = (g_vsTP[i] > 0) &&
         ((g_vsDirection[i] == 1) ? (checkPrice >= g_vsTP[i]) : (checkPrice <= g_vsTP[i]));

      if(hitSL || hitTP)
        {
         if(trade.PositionClose(g_vsPositionId[i]))
           {
            Print(hitSL ? "Virtual Stop Loss triggered - position closed." : "Virtual Take Profit triggered - position closed.");
            RemoveVirtualStop(i);
           }
         else
           {
            Print("Virtual SL/TP close failed. Retcode: ", trade.ResultRetcode(), " - ", trade.ResultRetcodeDescription());
           }
        }
     }

   // ===================== Rule 1: GBPUSD =====================
   {
      // Reset THIS rule's own round counter once ITS OWN tracked positions
      // have all closed - independent of every other rule's positions (see
      // CountTrackedForMagic() - matters most when two rules share a symbol).
      if(CountTrackedForMagic(MagicNumber_0) == 0)
         g_openRoundsSinceFlat_0 = 0;

      static datetime lastBarTime_0 = 0;
      datetime currentBarTime_0 = iTime(TradeSymbol_0, TradeTimeframe_0, 0);
      if(currentBarTime_0 != lastBarTime_0)
        {
         lastBarTime_0 = currentBarTime_0;
   double buf_ma_0[];
   ArraySetAsSeries(buf_ma_0, true);
   if(CopyBuffer(h_ma_0, 0, 0, 1, buf_ma_0) < 1)
     {
      Print("Failed to copy indicator buffer. Error: ", GetLastError());
      return;
     }
   double val_ma_0 = buf_ma_0[0];
   double buf_rsi_2[];
   ArraySetAsSeries(buf_rsi_2, true);
   if(CopyBuffer(h_rsi_2, 0, 0, 1, buf_rsi_2) < 1)
     {
      Print("Failed to copy indicator buffer. Error: ", GetLastError());
      return;
     }
   double val_rsi_2 = buf_rsi_2[0];
   double buf_atr_6[];
   ArraySetAsSeries(buf_atr_6, true);
   if(CopyBuffer(h_atr_6, 0, 0, 1, buf_atr_6) < 1)
     {
      Print("Failed to copy indicator buffer. Error: ", GetLastError());
      return;
     }
   double val_atr_6 = buf_atr_6[0];
         bool signalTriggered_0 = (((val_ma_0) > (SymbolInfoDouble(TradeSymbol_0, SYMBOL_BID))) && ((val_rsi_2) < (70.0)));
         if(signalTriggered_0)
           {
            if(g_openRoundsSinceFlat_0 < MaxSimultaneousPositions_0)
              {
               g_openRoundsSinceFlat_0++;
      // Action 1: Open BUY
      {
         // Lot from the builder is a target - snapped to this broker's actual
         // volume step/min/max, which vary widely broker to broker.
         double lotToTrade = NormalizeLot(TradeSymbol_0, 0.1);
         double entryPrice = SymbolInfoDouble(TradeSymbol_0, SYMBOL_ASK);
         double exitRefPrice = SymbolInfoDouble(TradeSymbol_0, SYMBOL_BID);
         double slDistance = ((2.0) * (val_atr_6));
         double tpDistance = ((1.5 / 100.0) * entryPrice);
         // This broker/account rejects server-side attached SL/TP as
         // "invalid stops" regardless of value, timing, or format (a known
         // quirk with some regulated brokers). So SL/TP is enforced by the
         // EA itself instead: no stops are sent to the server at all - the
         // levels are stored here and watched every tick, closing the
         // position manually when price crosses them. See the top of
         // OnTick() below. Note: MT5's position list won't show a Stop
         // Loss / Take Profit value, since none is registered with the
         // broker - the EA is managing the exit itself.
         // Magic number + filling mode are set right before sending, since a
         // single shared `trade` object is reused across every rule in this
         // file - each rule's orders must be tagged with ITS OWN magic number
         // so positions from different rules are never confused with each
         // other (see the Max-simultaneous-positions accounting below).
         trade.SetExpertMagicNumber(MagicNumber_0);
         trade.SetTypeFillingBySymbol(TradeSymbol_0);
         if(!trade.Buy(lotToTrade, TradeSymbol_0, 0, 0, 0, "Scratch for Traders"))
           {
            Print("BUY order failed. Retcode: ", trade.ResultRetcode(), " - ", trade.ResultRetcodeDescription());
           }
         else
           {
            // Track this position - even with no SL/TP - both so its virtual
            // stop can be enforced (see RegisterVirtualStop()) and so the
            // "Max simultaneous" position limit above can see it. A THEN block
            // can contain more than one action, so this is tracked by its own
            // MT5 position id rather than a single shared variable.
            ulong openedPositionId = ResolveOpenedPositionId();
            if(openedPositionId == 0)
              {
               Print("Could not resolve the position id opened by this BUY - it will not count toward the simultaneous-position limit or have virtual SL/TP enforced.");
              }
            else
              {
               // RegisterVirtualStop() derives the actual SL/TP levels itself,
               // blending this round's exit-side reference price with any
               // earlier round(s) already tracked under the same position id
               // (e.g. a netting account merging this order into an existing
               // position) - see its definition above for why that matters.
               RegisterVirtualStop(openedPositionId, TradeSymbol_0, MagicNumber_0, exitRefPrice, slDistance, tpDistance, 1, lotToTrade);
              }
           }
      }
      // Action 2: Open SELL
      {
         // Lot from the builder is a target - snapped to this broker's actual
         // volume step/min/max, which vary widely broker to broker.
         double lotToTrade = NormalizeLot(TradeSymbol_0, 0.2);
         double entryPrice = SymbolInfoDouble(TradeSymbol_0, SYMBOL_BID);
         double exitRefPrice = SymbolInfoDouble(TradeSymbol_0, SYMBOL_ASK);
         double slDistance = 0;
         double tpDistance = (50.0 * PipSize(TradeSymbol_0));
         // This broker/account rejects server-side attached SL/TP as
         // "invalid stops" regardless of value, timing, or format (a known
         // quirk with some regulated brokers). So SL/TP is enforced by the
         // EA itself instead: no stops are sent to the server at all - the
         // levels are stored here and watched every tick, closing the
         // position manually when price crosses them. See the top of
         // OnTick() below. Note: MT5's position list won't show a Stop
         // Loss / Take Profit value, since none is registered with the
         // broker - the EA is managing the exit itself.
         // Magic number + filling mode are set right before sending, since a
         // single shared `trade` object is reused across every rule in this
         // file - each rule's orders must be tagged with ITS OWN magic number
         // so positions from different rules are never confused with each
         // other (see the Max-simultaneous-positions accounting below).
         trade.SetExpertMagicNumber(MagicNumber_0);
         trade.SetTypeFillingBySymbol(TradeSymbol_0);
         if(!trade.Sell(lotToTrade, TradeSymbol_0, 0, 0, 0, "Scratch for Traders"))
           {
            Print("SELL order failed. Retcode: ", trade.ResultRetcode(), " - ", trade.ResultRetcodeDescription());
           }
         else
           {
            // Track this position - even with no SL/TP - both so its virtual
            // stop can be enforced (see RegisterVirtualStop()) and so the
            // "Max simultaneous" position limit above can see it. A THEN block
            // can contain more than one action, so this is tracked by its own
            // MT5 position id rather than a single shared variable.
            ulong openedPositionId = ResolveOpenedPositionId();
            if(openedPositionId == 0)
              {
               Print("Could not resolve the position id opened by this SELL - it will not count toward the simultaneous-position limit or have virtual SL/TP enforced.");
              }
            else
              {
               // RegisterVirtualStop() derives the actual SL/TP levels itself,
               // blending this round's exit-side reference price with any
               // earlier round(s) already tracked under the same position id
               // (e.g. a netting account merging this order into an existing
               // position) - see its definition above for why that matters.
               RegisterVirtualStop(openedPositionId, TradeSymbol_0, MagicNumber_0, exitRefPrice, slDistance, tpDistance, -1, lotToTrade);
              }
           }
      }
              }
           }
        }
     }

  }
//+------------------------------------------------------------------+
